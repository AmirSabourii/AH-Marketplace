# Copy to .env and fill in values.

# Catalog: medusa (default) reads GET /store/marketplace/products
# mock = local scenes.ts only (offline / no backend)
VITE_CATALOG_SOURCE=medusa

# Required for Medusa store API (catalog + room visualizer).
# From monorepo backend: cd apps/backend && npm run publishable-key
VITE_MEDUSA_PUBLISHABLE_KEY=

# Medusa store API (dev: leave unset — Vite proxies /store → localhost:9000)
# VITE_MEDUSA_BACKEND_URL=http://localhost:9000

# Optional: direct Gemini from browser when Medusa visualizer is unavailable
# VITE_GEMINI_API_KEY=

# Optional OpenRouter for AI assistant
# VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-001
