# Copy to .env and fill in values.

# Medusa store API (dev: leave VITE_MEDUSA_BACKEND_URL unset — Vite proxies /store → :9000)
# VITE_MEDUSA_BACKEND_URL=http://localhost:9000
VITE_MEDUSA_PUBLISHABLE_KEY=

# Optional: direct Gemini from browser when Medusa visualizer is unavailable
# VITE_GEMINI_API_KEY=

# Optional OpenRouter for AI assistant
# VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-001
