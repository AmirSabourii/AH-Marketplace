# Copy to .env and fill in values.

# mock = local scenes.ts | medusa = Medusa /store/marketplace/products
VITE_CATALOG_SOURCE=mock

# Room visualizer: Medusa SSE (needs backend on localhost:9000 + publishable key)
# VITE_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxx
# VITE_MEDUSA_BACKEND_URL=http://localhost:9000

# Room visualizer fallback when publishable key is unset (direct Gemini from browser)
VITE_GEMINI_API_KEY=

# Optional OpenRouter for AI assistant
# VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-001
